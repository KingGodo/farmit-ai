# FarmIT monorepo — ignore generated files and secrets, never source.

# --- secrets (commit .env.example only) ---
.env
.env.*
!.env.example

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- editors / IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# --- logs & debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*

# --- Java / Maven (farmitai-backend) ---
target/
.classpath
.project
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache
application-local.yml
application-local.properties

# --- Node / Next.js (website + dashboard) ---
node_modules/
.next/
out/
coverage/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- local TLS / certs ---
*.pem
*.key

# --- Docker named volumes are not in this tree; ignore local postgres dumps ---
*.sql.gz
dump.rdb
